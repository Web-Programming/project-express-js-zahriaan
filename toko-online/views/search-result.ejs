<!DOCTYPE html>
<html>
<head>
  <title><%= title %></title>
</head>
<body>
  <h1>Hasil Pencarian</h1>
  <% if (query) { %>
    <p>Menampilkan hasil untuk: "<%= query %>"</p>
  <% } else { %>
    <p>Menampilkan semua produk</p>
  <% } %>

  <ul>
    <% products.forEach(product => { %>
      <li><strong><%= product.name %></strong> - Rp<%= product.price %></li>
    <% }); %>
  </ul>

  <a href="/">Kembali ke Beranda</a>
</body>
</html>
